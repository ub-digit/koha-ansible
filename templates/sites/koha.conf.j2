<VirtualHost *:80>
    ServerName {{ intranet_server_name }}
    Redirect permanent / https://{{ intranet_server_name }}/
</VirtualHost>

<VirtualHost *:443>
    ServerName {{ intranet_server_name }}
    FallbackResource /index.html

    Include /etc/apache2/conf-shared/koha-apache-shared.conf

    ProxyPreserveHost Off

{% if inventory_hostname != 'production' %}

    # Mailpit for non production environments

    ProxyPass        /mail http://localhost:{{ mailpit_host_port }}/mail
    ProxyPassReverse /mail http://localhost:{{ mailpit_host_port }}/mail

    SSLProxyEngine on
    RewriteEngine on
    RewriteCond %{HTTP:Upgrade} websocket [NC]
    RewriteCond %{HTTP:Connection} upgrade [NC]
    RewriteRule ^/?(.*) "ws://localhost:{{ mailpit_host_port }}/$1" [P,L]

{% endif %}

    ProxyPass        / http://localhost:{{ intranet_host_port }}/
    ProxyPassReverse / http://localhost:{{ intranet_host_port }}/

</VirtualHost>


<VirtualHost *:80>
    ServerName {{ opac_server_name }}
    Redirect permanent / https://{{ opac_server_name }}/
</VirtualHost>

<VirtualHost *:443>
    ServerName {{ opac_server_name }}
    FallbackResource /index.html

    Include /etc/apache2/conf-shared/koha-apache-shared.conf

    ProxyPreserveHost Off

    ProxyPass        / http://localhost:{{ opac_host_port }}/
    ProxyPassReverse / http://localhost:{{ opac_host_port }}/

</VirtualHost>
