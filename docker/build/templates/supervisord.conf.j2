[supervisord]
nodaemon=true
logfile=/dev/null
logfile_maxbytes=0
pidfile=/tmp/supervisord.pid

[supervisorctl]
serverurl=unix:///tmp/supervisor.sock

[program:apache]
command=/usr/sbin/apachectl -D FOREGROUND
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stderr_logfile=/dev/stderr

[program:plack]
command=/usr/bin/starman -M FindBin --max-requests ${PLACK_MAX_REQUESTS} --workers ${PLACK_WORKERS} --pid /var/run/koha/{{ koha_instance_name }}/plack.pid --access-log /var/log/koha/{{ koha_instance_name }}/plack.log --error-log /var/log/koha/{{ koha_instance_name }}/plack-error.log -E ${PLACK_ENVIRONMENT} --socket /var/run/koha/{{ koha_instance_name }}/plack.sock /etc/koha/sites/${instancename}/plack.psgi
environment=KOHA_HOME="{{ koha_repo_path }}",KOHA_CONF="/etc/koha/sites/{{ koha_instance_name }}/koha-conf.xml",GIT_INSTALL=1,PERL5LIB="{{ perl5lib_paths }}"
user={{ koha_user }}
stdout_logfile=/dev/fd/1
stdout_logfile_maxbytes=0
redirect_stderr=true

[program:background-job-worker]
command={{ koha_repo_path }}/misc/workers/background_jobs_worker.pl --queue default --queue long_tasks
environment=KOHA_HOME="{{ koha_repo_path }}",KOHA_CONF="/etc/koha/sites/{{ koha_instance_name }}/koha-conf.xml",GIT_INSTALL=1,PERL5LIB="{{ perl5lib_paths }}"
user={{ koha_user }}
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stderr_logfile=/dev/stderr
