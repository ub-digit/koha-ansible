[supervisord]
user=root
nodaemon=true
logfile=/dev/null
logfile_maxbytes=0
pidfile=/tmp/supervisord.pid

[supervisorctl]
serverurl=unix:///tmp/supervisor.sock

[program:plack]
command=/usr/local/bin/run_with_ecs_logging.py plack /usr/bin/starman -M FindBin --max-requests ${PLACK_MAX_REQUESTS} --workers ${PLACK_WORKERS} --pid /run/koha-plack/plack.pid --access-log /var/log/koha/{{ koha_instance_name }}/plack.log --error-log /var/log/koha/{{ koha_instance_name }}/plack-error.log -E ${PLACK_ENVIRONMENT} --socket /run/koha-plack/plack.sock /etc/koha/plack.psgi
environment=KOHA_HOME="{{ koha_repo_path }}",KOHA_CONF="/etc/koha/sites/{{ koha_instance_name }}/koha-conf.xml",GIT_INSTALL=1,PERL5LIB="{{ perl5lib_paths }}"
user={{ koha_user }}
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
redirect_stderr=true

[program:background-job-worker-default]
command=/usr/local/bin/run_with_ecs_logging.py background-job-worker-default {{ koha_repo_path }}/misc/workers/background_jobs_worker.pl --queue default
environment=KOHA_HOME="{{ koha_repo_path }}",KOHA_CONF="/etc/koha/sites/{{ koha_instance_name }}/koha-conf.xml",PERL5LIB="{{ perl5lib_paths }}"
user={{ koha_user }}
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
redirect_stderr=true

[program:background-job-worker-long-tasks]
command=/usr/local/bin/run_with_ecs_logging.py background-job-worker-longs-tasks {{ koha_repo_path }}/misc/workers/background_jobs_worker.pl --queue long_tasks
environment=KOHA_HOME="{{ koha_repo_path }}",KOHA_CONF="/etc/koha/sites/{{ koha_instance_name }}/koha-conf.xml",PERL5LIB="{{ perl5lib_paths }}"
user={{ koha_user }}
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
redirect_stderr=true

[program:sip-server]
command=/usr/local/bin/run_with_ecs_logging.py sip-server /usr/bin/perl {{ koha_repo_path }}/C4/SIP/SIPServer.pm /etc/koha/sites/{{ koha_instance_name }}/SIPconfig.xml
environment=KOHA_HOME="{{ koha_repo_path }}",KOHA_CONF="/etc/koha/sites/{{ koha_instance_name }}/koha-conf.xml",PERL5LIB="{{ perl5lib_paths }}"
user={{ koha_user }}
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
redirect_stderr=true

[program:elasticsearch-indexer]
command=/usr/local/bin/run_with_ecs_logging.py elasticsearch-indexer {{ koha_repo_path }}/misc/workers/es_indexer_daemon.pl --batch_size 10
environment=KOHA_HOME="{{ koha_repo_path }}",KOHA_CONF="/etc/koha/sites/{{ koha_instance_name }}/koha-conf.xml",PERL5LIB="{{ perl5lib_paths }}"
user={{ koha_user }}
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
redirect_stderr=true

