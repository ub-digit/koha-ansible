#!/usr/bin/bash

#export LANGUAGE='en_US.UTF-8'
#export LC_ALL='en_US.UTF-8'

shopt -s histappend

# executable -> green
export CLICOLOR=1
export LSCOLORS=ExFxBxDxCxegedabagacad

if [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
fi

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

export PATH="${PATH}:{{ [koha_repo_path, 'node_modules/.bin'] | path_join }}"
export KOHA_CONF="{{ [site_dir, 'koha-conf.xml'] | path_join }}"
export KOHA_HOME="{{ koha_repo_path }}"
export PERL5LIB="{{ perl5lib_paths }}:{{ qa_home }}"

PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\W\[\033[00m\]$(__git_ps1 "\[\e[1;33m\](%s)\[\e[0m\]")$ '

# function for running updatedatabase.pl
function updatedatabase(){
    koha-shell {{ koha_instance_name }} -p -c "perl {{ [koha_repo_path, 'installer/data/mysql/updatedatabase.pl'] | path_join }}"
}
