FROM debian:13

# TODO: Apt cleanup

WORKDIR /root/ansible/docker/build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y sudo ansible-core \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

COPY ./server-setup.yml ./
COPY ./build.yml ./
COPY ./host_vars ./host_vars
COPY ./templates ./templates
COPY ./requirements.yml ./

RUN ansible-galaxy install -r requirements.yml
RUN ansible-playbook -i build.yml server-setup.yml

# Set locales (could move to playbook)
# ENV LANG=en_US.UTF-8 # wtf, angular crash invalid locale

# Set timezone
RUN ln -fs /usr/share/zoneinfo/Europe/Stockholm /etc/localtime \
    && echo "Europe/Stockholm" > /etc/timezone

# Prepare apache configuration
RUN a2dismod mpm_event
RUN a2dissite 000-default
RUN a2enmod rewrite \
    headers \
    proxy_http \
    cgi

# Add nodejs repo
RUN wget -O- -q https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    | gpg --dearmor \
    | tee /usr/share/keyrings/nodesource.gpg >/dev/null \
    && echo "deb [signed-by=/usr/share/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" > /etc/apt/sources.list.d/nodesource.list

# Add Yarn repo
RUN curl -fsSL https://dl.yarnpkg.com/debian/pubkey.gpg \
    | gpg --dearmor \
    | tee /usr/share/keyrings/yarn.gpg > /dev/null \
    && echo "deb [trusted=yes] https://dl.yarnpkg.com/debian stable main" \
    > /etc/apt/sources.list.d/yarn.list

# Install node and yarn
RUN apt-get update \
 && apt-get install -y nodejs yarn \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Install some nodejs tools
RUN yarn global add gulp-cli
