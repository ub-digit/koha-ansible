FROM alpine:latest AS release
RUN apk add --no-cache git

ARG GIT_REVISION
ARG GIT_REPO_URL

WORKDIR /root/

RUN set -eux \
  && git clone "$GIT_REPO_URL" release -b "$GIT_REVISION" --depth 1

FROM docker.ub.gu.se/koha-base:server

ARG KOHA_REPO_PATH=/opt/koha

COPY --from=release /root/release ${KOHA_REPO_PATH}

COPY ./koha-setup.yml ./
COPY ./inventory/koha.yml ./
COPY ./requirements.yml ./
COPY ./files/koha-create ./files/koha-create

RUN ansible-galaxy install -r requirements.yml
RUN ansible-playbook -i koha.yml -e koha_repo_path=${KOHA_REPO_PATH} koha-setup.yml

#RUN cpan-outdated --exclude-core -p | cpanm
RUN cpanm --skip-installed --installdeps ${KOHA_REPO_PATH}

# TODO: Move to playbook?
RUN pip install supervisor

COPY ./koha-instance-setup.yml ./
COPY ./vars/shared.yml ./vars/shared.yml
COPY ./vars/scripts.yml ./vars/scripts.yml
COPY ./inventory/instance.yml ./
COPY ./files ./files
COPY ./templates ./templates
RUN ansible-playbook -i instance.yml -e koha_repo_path=${KOHA_REPO_PATH} koha-instance-setup.yml

COPY ./koha-plugins-setup.yml ./
RUN ansible-playbook -i instance.yml -e koha_repo_path=${KOHA_REPO_PATH} koha-plugins-setup.yml

COPY ./koha-scripts-setup.yml ./
RUN ansible-playbook -i instance.yml koha-scripts-setup.yml

COPY ./koha-apache-setup.yml ./
RUN ansible-playbook -i koha.yml koha-apache-setup.yml

# Add nodejs repo
RUN wget -O- -q https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    | gpg --dearmor \
    | tee /usr/share/keyrings/nodesource.gpg >/dev/null \
    && echo "deb [signed-by=/usr/share/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" > /etc/apt/sources.list.d/nodesource.list

# Add Yarn repo
RUN curl -fsSL https://dl.yarnpkg.com/debian/pubkey.gpg \
    | gpg --dearmor \
    | tee /usr/share/keyrings/yarn.gpg > /dev/null \
    && echo "deb [trusted=yes] https://dl.yarnpkg.com/debian stable main" \
    > /etc/apt/sources.list.d/yarn.list

ENV KOHA_HOME=${KOHA_REPO_PATH}
ENV GIT_INSTALL=1
ENV PERL5LIB="${KOHA_REPO_PATH}/lib:${KOHA_REPO_PATH}"

WORKDIR ${KOHA_REPO_PATH}

# docker-entrypoint.sh created from template in koha-instance-setup.yml
ENTRYPOINT ["docker-entrypoint.sh"]
